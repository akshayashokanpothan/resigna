NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Set to split the landing page onto its own host (e.g. https://beta.resigna.akshayashokanpothan.com).
NEXT_PUBLIC_LANDING_URL=

# Optional, server only: pinned copy of the public JWT signing keys from
# <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/.well-known/jwks.json (one line of JSON).
# Saves the proxy a 0.7–1 s fetch on each cold start. Public keys, not a secret.
# SUPABASE_JWKS={"keys":[...]}
